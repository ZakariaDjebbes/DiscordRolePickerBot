# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the same page -> General Information
DISCORD_CLIENT_ID=

# The guild (server) the picker runs in. Commands are registered per guild so
# they appear instantly instead of waiting on global command propagation.
DISCORD_GUILD_ID=

# Optional: path to the role group config. Defaults to ./config/roles.json
ROLE_CONFIG_PATH=./config/roles.json

# Optional: where posted picker message IDs and resolved role IDs are
# remembered. Defaults to ./data/picker-state.json
STATE_PATH=./data/picker-state.json

# Logging ---------------------------------------------------------------------

# debug | info | warn | error. Defaults to info.
# debug also records clicks that changed nothing.
LOG_LEVEL=info

# Log file path. Set to an empty value to log to the console only.
# Defaults to ./logs/rolepicker.log
LOG_FILE=./logs/rolepicker.log

# Rotate once the file passes this size, keeping this many older files.
# Defaults to 5 MB and 5 files (~25 MB total).
LOG_MAX_SIZE_MB=5
LOG_MAX_FILES=5

# Timestamps use the process timezone. Set TZ to see them in local time;
# containers default to UTC.
# TZ=Europe/Paris

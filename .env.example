# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID from the same page -> General Information
DISCORD_CLIENT_ID=

# The guild (server) the picker runs in. Commands are registered per guild so
# they appear instantly instead of waiting on global command propagation.
DISCORD_GUILD_ID=

# Optional: path to the role group config. Defaults to ./config/roles.json
ROLE_CONFIG_PATH=./config/roles.json

# Optional: where posted picker message IDs are remembered.
# Defaults to ./data/picker-state.json
STATE_PATH=./data/picker-state.json
